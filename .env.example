RIGEL_ADMIN_USER=admin
RIGEL_ADMIN_PASSWORD=cambia-esta-clave
# En producción mantenlo en 0. El valor 1 permite admin/rigel-admin únicamente en localhost.
RIGEL_ALLOW_LOCAL_DEFAULTS=0
RIGEL_DATA_DIR=backend/data
RIGEL_DATABASE=backend/data/rigel.sqlite3
RIGEL_UPLOAD_DIR=backend/data/uploads
# Opcional: URL pública /exec de Google Apps Script para duplicar cada contacto en Google Sheets.
GOOGLE_SHEETS_WEBHOOK_URL=
